* {
	primary: #91d5ac;
    primary-fixed: #adf2c7;
    primary-fixed-dim: #91d5ac;
    on-primary: #003921;
    on-primary-fixed: #002111;
    on-primary-fixed-variant: #045233;
    primary-container: #045233;
    on-primary-container: #adf2c7;
    secondary: #b5ccbb;
    secondary-fixed: #d0e8d6;
    secondary-fixed-dim: #b5ccbb;
    on-secondary: #213529;
    on-secondary-fixed: #0b1f14;
    on-secondary-fixed-variant: #374b3e;
    secondary-container: #374b3e;
    on-secondary-container: #d0e8d6;
    tertiary: #a4cddc;
    tertiary-fixed: #bfe9f9;
    tertiary-fixed-dim: #a4cddc;
    on-tertiary: #043542;
    on-tertiary-fixed: #001f27;
    on-tertiary-fixed-variant: #224c59;
    tertiary-container: #224c59;
    on-tertiary-container: #bfe9f9;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #0f1511;
    on-surface: #dfe4dd;
    on-surface-variant: #c0c9c0;
    outline: #8a938b;
    outline-variant: #404942;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #dfe4dd;
    inverse-on-surface: #2c322d;
    inverse-primary: #276a49;
    surface-dim: #0f1511;
    surface-bright: #353b36;
    surface-container-lowest: #0a0f0c;
    surface-container-low: #171d19;
    surface-container: #1b211d;
    surface-container-high: #262b27;
    surface-container-highest: #303632;
    background: #0f1511;
    foreground: #dfe4dd;
}


configuration{
	drun-display-format: "{icon} {name}";
	show-icons: true;
	display-drun: "";
	window-format: "{c}: {t}";
}

window {
    width: 600px;
    border: 2px;
    border-color: @primary-container;
    border-radius: 18px;
    background-color: @background;
    text-color: @foreground;
}

mainbox {
    padding: 20px;
    spacing: 15px;
    background-color: @background;
}

inputbar {
    padding: 12px;
    border-radius: 12px;

    background-color: @background;
    text-color: @foreground;
}

prompt {
    padding: 0 10px 0 0;
    text-color: @foreground;
}

entry {
    text-color: @foreground;
}

listview {
    spacing: 6px;
    lines: 8;
    columns: 1;
    scrollbar: false;
    background-color: @background;
}

element {
    padding: 10px 14px;
    border-radius: 10px;

    background-color: transparent;
    text-color: @foreground;
}

element-text {
    text-color: inherit;
}

element-icon {
    size: 24px;
    padding: 0 10px 0 0;
}

element selected {
        text-color: @background;
        background-color: @primary-container;
        
}
element alternate active {
        text-color: @background;
        background-color: @primary-container;
        
}

element selected element-text {
    text-color: inherit;
}

element selected element-icon {
    text-color: inherit;
}

message {
    padding: 10px;
    text-color: @foreground;
}

error-message {
    text-color: @error;
}








element alternate {
    background-color: @background;
    text-color: @on-surface;
}

element urgent {
    background-color: @error-container;
    text-color: @on-error-container;
}

element active {
    background-color: @primary-container;
    text-color: @on-primary-container;
}

element selected {
    background-color: @primary-container;
    text-color: @on-primary-container;
}

element selected normal {
    background-color: @primary-container;
    text-color: @on-primary-container;
}

@theme "/usr/share/rofi/themes/gruvbox-dark.rasi"
